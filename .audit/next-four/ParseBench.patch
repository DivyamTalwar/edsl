+"""Public evaluator thread-pool contract and signal-ownership regressions."""
+
+from __future__ import annotations
+
+import signal
+import time
+import warnings
+from concurrent.futures import ThreadPoolExecutor
+from datetime import UTC, datetime
+
+import pytest
+
+from parse_bench.evaluation.evaluators.parse import ParseEvaluator
+from parse_bench.evaluation.metrics.parse import rule_based_metric
+from parse_bench.evaluation.metrics.parse.rule_based_metric import RuleBasedMetric
+from parse_bench.schemas.parse_output import ParseOutput
+from parse_bench.schemas.pipeline_io import InferenceRequest, InferenceResult
+from parse_bench.schemas.product import ProductType
+from parse_bench.test_cases.parse_rule_schemas import coerce_parse_rule
+from parse_bench.test_cases.schema import ParseTestCase
+
+_WARNING = "Hard normalization and per-rule timeouts are unavailable"
+
+
+def _evaluate(markdown: str, expected_text: str) -> float:
+    now = datetime.now(UTC)
+    test_case = ParseTestCase(
+        test_id="thread/doc", group="thread", file_path="doc.pdf",
+        test_rules=[coerce_parse_rule({"type": "present", "text": expected_text})],
+    )
+    inference = InferenceResult(
+        request=InferenceRequest(example_id="thread/doc", source_file_path="doc.pdf", product_type=ProductType.PARSE),
+        pipeline_name="thread-test", product_type=ProductType.PARSE, raw_output={},
+        output=ParseOutput(example_id="thread/doc", pipeline_name="thread-test", markdown=markdown),
+        started_at=now, completed_at=now, latency_in_ms=1,
+    )
+    evaluator = ParseEvaluator(
+        enable_rule_based=True, enable_text_similarity=False, enable_teds=False,
+        enable_grits=False, enable_header_accuracy=False, enable_structural_consistency=False,
+        enable_table_record_match=False, enable_table_composite=False,
+    )
+    result = evaluator.evaluate(inference, test_case)
+    return next(metric.value for metric in result.metrics if metric.metric_name == "rule_pass_rate")
+
+
+@pytest.mark.parametrize(("markdown", "expected_text", "score"), [
+    ("alpha beta", "alpha", 1.0), ("alpha beta", "unrelated", 0.0),
+])
+def test_public_evaluator_runs_in_thread_pool(markdown: str, expected_text: str, score: float) -> None:
+    with ThreadPoolExecutor(max_workers=1) as executor, pytest.warns(RuntimeWarning, match=_WARNING):
+        assert executor.submit(_evaluate, markdown, expected_text).result(timeout=15) == score
+
+
+def test_concurrent_evaluations_keep_their_own_inputs() -> None:
+    cases = [("alpha", "alpha", 1.0), ("beta", "alpha", 0.0), ("gamma", "gamma", 1.0)]
+    with ThreadPoolExecutor(max_workers=3) as executor, pytest.warns(RuntimeWarning, match=_WARNING):
+        futures = [executor.submit(_evaluate, text, expected) for text, expected, _ in cases]
+        assert [future.result(timeout=15) for future in futures] == [score for _, _, score in cases]
+
+
+@pytest.mark.skipif(not hasattr(signal, "SIGALRM"), reason="requires Unix signal API")
+def test_threaded_evaluation_never_touches_process_alarm(monkeypatch: pytest.MonkeyPatch) -> None:
+    def forbidden(*args: object, **kwargs: object) -> None:
+        pytest.fail("thread-pool evaluation attempted to alter the process alarm")
+
+    monkeypatch.setattr(signal, "signal", forbidden)
+    monkeypatch.setattr(signal, "alarm", forbidden)
+    with ThreadPoolExecutor(max_workers=1) as executor, pytest.warns(RuntimeWarning, match=_WARNING):
+        assert executor.submit(_evaluate, "alpha", "alpha").result(timeout=15) == 1.0
+
+
+@pytest.mark.skipif(not hasattr(signal, "SIGALRM"), reason="requires Unix signal API")
+def test_main_thread_preserves_handler_without_fallback_warning() -> None:
+    before = signal.getsignal(signal.SIGALRM)
+    with warnings.catch_warnings(record=True) as emitted:
+        warnings.simplefilter("always")
+        assert _evaluate("alpha", "alpha") == 1.0
+    assert signal.getsignal(signal.SIGALRM) == before
+    assert not any(_WARNING in str(item.message) for item in emitted)
+
+
+def test_document_budget_remains_cooperative_in_thread_pool(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("BENCH_DOC_RULE_BUDGET_SECONDS", "1e-9")
+    with ThreadPoolExecutor(max_workers=1) as executor, pytest.warns(RuntimeWarning, match=_WARNING):
+        result = executor.submit(
+            RuleBasedMetric().compute,
+            expected=[{"type": "present", "text": "alpha"}] * 3,
+            actual="alpha beta",
+        ).result(timeout=15)
+    assert result.metadata["skipped_over_budget"] >= 1
+    assert result.metadata["total"] == 3
+
+
+@pytest.mark.skipif(not hasattr(signal, "SIGALRM"), reason="requires Unix signal API")
+def test_normalization_error_restores_main_thread_handler(monkeypatch: pytest.MonkeyPatch) -> None:
+    before = signal.getsignal(signal.SIGALRM)
+
+    def fail_normalization(text: str) -> str:
+        raise ValueError("normalization failed")
+
+    monkeypatch.setattr(rule_based_metric, "normalize_text", fail_normalization)
+    with pytest.raises(ValueError, match="normalization failed"):
+        _evaluate("alpha", "alpha")
+    assert signal.getsignal(signal.SIGALRM) == before
+
+
+@pytest.mark.skipif(not hasattr(signal, "SIGALRM"), reason="requires Unix signal API")
+def test_main_thread_alarm_still_interrupts_normalization(monkeypatch: pytest.MonkeyPatch) -> None:
+    before = signal.getsignal(signal.SIGALRM)
+
+    def slow_normalization(text: str) -> str:
+        time.sleep(5)
+        return text
+
+    monkeypatch.setattr(rule_based_metric, "normalize_text", slow_normalization)
+    monkeypatch.setattr(rule_based_metric, "RULE_TIMEOUT_SECONDS", 1)
+    started = time.monotonic()
+    result = RuleBasedMetric().compute(expected=[{"type": "present", "text": "alpha"}], actual="alpha")
+    assert result.value == 0.0
+    assert "normalization exceeded 1s" in result.metadata["note"]
+    assert time.monotonic() - started < 4
+    assert signal.getsignal(signal.SIGALRM) == before
