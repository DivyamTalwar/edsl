+package v2
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/mock/gomock"
+
+	"github.com/formancehq/go-libs/v5/pkg/authn/jwt"
+	"github.com/formancehq/go-libs/v5/pkg/transport/api"
+	ledger "github.com/formancehq/ledger/internal"
+)
+
+func TestInsertSchemaRejectsUnknownChartProperties(t *testing.T) {
+	t.Parallel()
+	cases := []struct {
+		name, chart, key, path string
+	}{
+		{"pattern typo", `{"bank":{".patern":"^[A-Z]+$"}}`, ".patern", "bank"},
+		{"rules typo", `{"bank":{".rulez":{}}}`, ".rulez", "bank"},
+		{"metadata typo", `{"bank":{".metadatas":{"x":{"default":"y"}}}}`, ".metadatas", "bank"},
+		{"unknown array", `{"bank":{".anything-at-all":[1,2,3]}}`, ".anything-at-all", "bank"},
+		{"unknown null", `{"bank":{".forbiden":null}}`, ".forbiden", "bank"},
+		{"nested fixed", `{"bank":{"cash":{".rulez":{}}}}`, ".rulez", "bank:cash"},
+		{"nested variable", `{"bank":{"$id":{".pattern":"^[A-Z]+$",".patern":"x"}}}`, ".patern", "bank:$id"},
+		{"non-leaf", `{"bank":{".patern":"x","child":{}}}`, ".patern", "bank"},
+		{"deterministic diagnostic", `{"bank":{".zzz":{},".aaa":{}}}`, ".aaa", "bank"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			systemController, _ := newTestingSystemController(t, true)
+			// No InsertSchema expectation: a call would fail this test before any write.
+			router := NewRouter(systemController, jwt.NewNoAuth(), "develop")
+			req := httptest.NewRequest(http.MethodPost, "/default/schemas/v1", bytes.NewBufferString(`{"chart":`+tc.chart+`}`))
+			rec := httptest.NewRecorder()
+			router.ServeHTTP(rec, req)
+			require.Equal(t, http.StatusBadRequest, rec.Code)
+			var response api.ErrorResponse
+			require.NoError(t, json.Unmarshal(rec.Body.Bytes(), &response))
+			require.Equal(t, "VALIDATION", response.ErrorCode)
+			require.Contains(t, rec.Body.String(), tc.key)
+			require.Contains(t, rec.Body.String(), tc.path)
+		})
+	}
+}
+
+func TestInsertSchemaKnownChartPropertiesRemainAccepted(t *testing.T) {
+	t.Parallel()
+	for name, chart := range map[string]string{
+		"leaf":               `{"bank":{}}`,
+		"self":               `{"bank":{".self":{},"cash":{}}}`,
+		"pattern":            `{"bank":{"$id":{".pattern":"^[A-Z]+$"}}}`,
+		"metadata namespace": `{"bank":{".metadata":{".patern":{"default":"kept"}}}}`,
+		"rules":              `{"bank":{".rules":{}}}`,
+		"combined":           `{"bank":{".self":{},".metadata":{"currency":{"default":"USD"}},".rules":{},"$id":{".pattern":"^[0-9]+$"}}}`,
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			systemController, ledgerController := newTestingSystemController(t, true)
+			ledgerController.EXPECT().InsertSchema(gomock.Any(), gomock.Any()).Return(nil, nil, false, nil)
+			router := NewRouter(systemController, jwt.NewNoAuth(), "develop")
+			req := httptest.NewRequest(http.MethodPost, "/default/schemas/v1", bytes.NewBufferString(`{"chart":`+chart+`}`))
+			rec := httptest.NewRecorder()
+			router.ServeHTTP(rec, req)
+			require.Equal(t, http.StatusNoContent, rec.Code, rec.Body.String())
+		})
+	}
+}
+
+func TestStoredLegacyChartStillDecodes(t *testing.T) {
+	t.Parallel()
+	var schema ledger.Schema
+	err := json.Unmarshal([]byte(`{"version":"legacy","chart":{"bank":{".patern":"ignored historically"}}}`), &schema)
+	require.NoError(t, err, "read-side decoding must not be made strict by HTTP admission validation")
+	require.NotNil(t, schema.Chart["bank"].Account)
+	encoded, err := json.Marshal(schema)
+	require.NoError(t, err)
+	var roundTrip ledger.Schema
+	require.NoError(t, json.Unmarshal(encoded, &roundTrip))
+	require.NotNil(t, roundTrip.Chart["bank"].Account)
+}
