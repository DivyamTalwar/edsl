new file mode 100644
index 0000000..8d233dc
--- /dev/null
+++ b/internal/api/v2/schema_chart_properties.go
@@ -0,0 +1,68 @@
+package v2
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+
+	ledger "github.com/formancehq/ledger/internal"
+)
+
+// validateSchemaChartProperties is a write-boundary check, not a replacement
+// for ChartOfAccounts.UnmarshalJSON. Legacy schemas must remain readable.
+// Call it after the ordinary decoder has checked chart structure and values.
+func validateSchemaChartProperties(payload json.RawMessage) error {
+	var data struct {
+		Chart json.RawMessage `json:"chart"`
+	}
+	if err := json.Unmarshal(payload, &data); err != nil {
+		return err
+	}
+	if len(data.Chart) == 0 {
+		return nil
+	}
+	var chart map[string]json.RawMessage
+	if err := json.Unmarshal(data.Chart, &chart); err != nil {
+		return err
+	}
+	keys := make([]string, 0, len(chart))
+	for key := range chart {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		if err := validateChartSegmentProperties(chart[key], key); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func validateChartSegmentProperties(raw json.RawMessage, path string) error {
+	var segment map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &segment); err != nil {
+		return err
+	}
+	keys := make([]string, 0, len(segment))
+	for key := range segment {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		if strings.HasPrefix(key, ledger.PROPERTY_PREFIX) {
+			switch key {
+			case ledger.SELF_KEY, ledger.METADATA_KEY, ledger.RULES_KEY, ledger.PATTERN_KEY:
+				// Metadata and rules have their own namespaces; do not recurse
+				// into their arbitrary user keys as if they were chart segments.
+				continue
+			default:
+				return fmt.Errorf("unknown chart property %q at segment %q", key, path)
+			}
+		}
+		if err := validateChartSegmentProperties(segment[key], path+":"+key); err != nil {
+			return err
+		}
+	}
+	return nil
+}
